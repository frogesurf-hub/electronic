<Window x:Class="DesktopCompanion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="电子杯 · 查询助手"
        Width="920"
        Height="700"
        MinWidth="520"
        MinHeight="400">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection status -->
        <Border Grid.Row="0"
                Padding="12"
                BorderThickness="1"
                BorderBrush="Gray"
                CornerRadius="6">

            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="100" Height="30" Content="新建会话"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding CanStartNewSession}"
                            Click="NewSessionButton_Click" />
                    <Button Width="100" Height="30" Content="连接"
                            Click="ConnectButton_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal">

                    <TextBlock Text="Agent Core:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />

                    <TextBlock Text="{Binding ConnectionStatus}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Message history -->
        <ListBox Grid.Row="1"
                 Margin="0,16"
                 Padding="8"
                 ItemsSource="{Binding Messages}">

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <TextBlock Text="{Binding}"
                               Margin="4"
                               TextWrapping="Wrap" />

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <GroupBox Grid.Row="2" Header="{Binding ResultStatus}" Margin="0,0,0,12">
            <TabControl>
                <TabItem Header="原文引用">
                    <TextBox Text="{Binding CitationText, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </TabItem>
                <TabItem Header="结果表格">
                    <DataGrid ItemsSource="{Binding ResultRows}" IsReadOnly="True"
                              AutoGenerateColumns="True" CanUserAddRows="False" />
                </TabItem>
                <TabItem Header="实际 SQL">
                    <TextBox Text="{Binding QuerySql, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </TabItem>
                <TabItem Header="条件与执行记录">
                    <TextBox Text="{Binding QueryDetails, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </TabItem>
            </TabControl>
        </GroupBox>

        <!-- Input area -->
        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Height="36"
                     Margin="0,0,10,0"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     Text="{Binding InputText,
                                    UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1"
                    Width="90"
                    Height="36"
                    Content="发送"
                    IsEnabled="{Binding CanSend}"
                    Click="SendButton_Click" />

        </Grid>

    </Grid>
</Window>
